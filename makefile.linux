# OpenGW - Linux/Raspberry Pi Makefile
#
# Usage:
#   make -f makefile.linux              # builds both opengw_sdl and opengw_dvg
#   make -f makefile.linux sdl          # SDL/OpenGL renderer only
#   make -f makefile.linux dvg          # DVG renderer only
#   make -f makefile.linux clean

CXX = g++
DVG_UTILS = ../dvg_utils

CXXFLAGS_COMMON = -std=c++20 -Wall -Wextra -O3 -ggdb -I. -I/usr/local/include -I$(DVG_UTILS)

CXXFLAGS_SDL = $(CXXFLAGS_COMMON)
CXXFLAGS_DVG = $(CXXFLAGS_COMMON) -DUSE_DVG_RENDERER

LIBS_SDL = -lSDL2 -lGL -lGLU
LIBS_DVG = -lSDL2

ALL_SRC = $(wildcard *.cpp)
SRC_FILES = $(notdir $(ALL_SRC))

OBJDIR_SDL = obj_sdl
OBJDIR_DVG = obj_dvg

OBJS_SDL = $(patsubst %.cpp,$(OBJDIR_SDL)/%.o,$(SRC_FILES)) $(OBJDIR_SDL)/advmame_rc.o $(OBJDIR_SDL)/cfg_file.o $(OBJDIR_SDL)/keyboard_leds.o
OBJS_DVG = $(patsubst %.cpp,$(OBJDIR_DVG)/%.o,$(SRC_FILES)) $(OBJDIR_DVG)/advmame_rc.o $(OBJDIR_DVG)/cfg_file.o $(OBJDIR_DVG)/dvg_cmd.o $(OBJDIR_DVG)/dvg_serial_linux.o $(OBJDIR_DVG)/keyboard_leds.o

DEPS_SDL = $(OBJS_SDL:.o=.d)
DEPS_DVG = $(OBJS_DVG:.o=.d)

all: sdl dvg

sdl: $(OBJDIR_SDL) opengw_sdl

dvg: $(OBJDIR_DVG) opengw_dvg

$(OBJDIR_SDL):
	mkdir -p $(OBJDIR_SDL)

$(OBJDIR_DVG):
	mkdir -p $(OBJDIR_DVG)

opengw_sdl: $(OBJS_SDL)
	$(CXX) -o $@ $^ $(LIBS_SDL)

opengw_dvg: $(OBJS_DVG)
	$(CXX) -o $@ $^ $(LIBS_DVG)

# SDL build
$(OBJDIR_SDL)/%.d: %.cpp | $(OBJDIR_SDL)
	$(CXX) -MM -MP -MT $(@:.d=.o) -o $@ $< $(CXXFLAGS_SDL)

$(OBJDIR_SDL)/%.o: %.cpp
	$(CXX) $(CXXFLAGS_SDL) -c $< -o $@

$(OBJDIR_SDL)/advmame_rc.o: $(DVG_UTILS)/advmame_rc.cpp | $(OBJDIR_SDL)
	$(CXX) $(CXXFLAGS_SDL) -c $< -o $@

$(OBJDIR_SDL)/cfg_file.o: $(DVG_UTILS)/cfg_file.cpp | $(OBJDIR_SDL)
	$(CXX) $(CXXFLAGS_SDL) -I$(DVG_UTILS) -c $< -o $@

# DVG build
$(OBJDIR_DVG)/%.d: %.cpp | $(OBJDIR_DVG)
	$(CXX) -MM -MP -MT $(@:.d=.o) -o $@ $< $(CXXFLAGS_DVG)

$(OBJDIR_DVG)/%.o: %.cpp
	$(CXX) $(CXXFLAGS_DVG) -c $< -o $@

$(OBJDIR_DVG)/advmame_rc.o: $(DVG_UTILS)/advmame_rc.cpp | $(OBJDIR_DVG)
	$(CXX) $(CXXFLAGS_DVG) -c $< -o $@

$(OBJDIR_DVG)/cfg_file.o: $(DVG_UTILS)/cfg_file.cpp | $(OBJDIR_DVG)
	$(CXX) $(CXXFLAGS_DVG) -I$(DVG_UTILS) -c $< -o $@

$(OBJDIR_DVG)/dvg_cmd.o: $(DVG_UTILS)/dvg_cmd.cpp | $(OBJDIR_DVG)
	$(CXX) $(CXXFLAGS_DVG) -I$(DVG_UTILS) -c $< -o $@

$(OBJDIR_DVG)/dvg_serial_linux.o: $(DVG_UTILS)/dvg_serial_linux.cpp | $(OBJDIR_DVG)
	$(CXX) $(CXXFLAGS_DVG) -I$(DVG_UTILS) -c $< -o $@

$(OBJDIR_SDL)/keyboard_leds.o: $(DVG_UTILS)/keyboard_leds.cpp | $(OBJDIR_SDL)
	$(CXX) $(CXXFLAGS_SDL) -c $< -o $@

$(OBJDIR_DVG)/keyboard_leds.o: $(DVG_UTILS)/keyboard_leds.cpp | $(OBJDIR_DVG)
	$(CXX) $(CXXFLAGS_DVG) -c $< -o $@

PREFIX = /usr/local/share/advance

install: all
	@if findmnt -t overlay /usr/local/share/advance >/dev/null 2>&1 \
	    || systemctl is-active --quiet usr-local-share-advance.automount; then \
	    echo "ERROR: overlay is active on /usr/local/share/advance."; \
	    echo "       Writes would be captured in the upper layer, not the raw"; \
	    echo "       install tree. Run these three commands instead:"; \
	    echo ""; \
	    echo "           sudo /home/pi/vectorpiemenu/overlay/overlay-stop.sh"; \
	    echo "           sudo make -f makefile.linux install"; \
	    echo "           sudo /home/pi/vectorpiemenu/overlay/overlay-start.sh"; \
	    echo ""; \
	    exit 1; \
	fi
	@if [ "$$(stat -c %i /usr/local/share/advance)" != "$$(stat -c %i /var/local/overlay_advance/lower)" ]; then \
	    echo "ERROR: /usr/local/share/advance is not bound to /var/local/overlay_advance/lower."; \
	    echo "       Install would land in an empty mount point, not the base tree."; \
	    echo "       Run: sudo /home/pi/vectorpiemenu/overlay/overlay-stop.sh"; \
	    exit 1; \
	fi
	install -d $(PREFIX)
	install -d $(PREFIX)/artwork
	install -d $(PREFIX)/opengw_dir/sounds
	install -m 755 opengw_sdl opengw_dvg $(PREFIX)/
	install -m 644 opengw.cfg $(PREFIX)/
	install -m 644 sounds/*.wav $(PREFIX)/opengw_dir/sounds/

clean:
	rm -rf $(OBJDIR_SDL) $(OBJDIR_DVG) opengw_sdl opengw_dvg

.PHONY: all sdl dvg clean install

# Load .d files
ifneq ($(MAKECMDGOALS),clean)
-include $(DEPS_SDL)
-include $(DEPS_DVG)
endif
